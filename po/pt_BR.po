#: src/cos_config/modules/multimedia.py:77
msgid ""
"Many videos and songs use formats that Fedora cannot include because of "
"patents. Turn on what you want and apply."
msgstr ""
"Muitos vídeos e músicas usam formatos que o Fedora não pode incluir por "
"causa de patentes. Ligue o que quiser e aplique."

