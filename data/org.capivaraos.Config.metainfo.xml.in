<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 CapivaraOS Project -->
<component type="desktop-application">
  <id>org.capivaraos.Config</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>COS Config Center</name>
  <summary>Get to know and tune your Linux system</summary>

  <description>
    <p>
      COS Config Center is the configuration center of the CapivaraOS project:
      a friendly place to get to know your system and tune it without typing
      commands. It shows your distribution, kernel, desktop, CPU, GPU, memory
      and more, has a live dashboard of system activity, and lets you export a
      good-looking card to share your specs.
    </p>
    <p>
      It runs on any Linux desktop and is a gift from the CapivaraOS project,
      a friendly Linux distribution with a capybara at its heart.
    </p>
  </description>

  <launchable type="desktop-id">org.capivaraos.Config.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <caption>System information at a glance</caption>
      <image>https://raw.githubusercontent.com/capivaraos/cos-config/main/data/screenshots/system.png</image>
    </screenshot>
    <screenshot>
      <caption>Live dashboard with real-time gauges and charts</caption>
      <image>https://raw.githubusercontent.com/capivaraos/cos-config/main/data/screenshots/live.png</image>
    </screenshot>
    <screenshot>
      <caption>Export a shareable specs card</caption>
      <image>https://raw.githubusercontent.com/capivaraos/cos-config/main/data/screenshots/share.png</image>
    </screenshot>
    <screenshot>
      <caption>A gift from the CapivaraOS project</caption>
      <image>https://raw.githubusercontent.com/capivaraos/cos-config/main/data/screenshots/capivaraos.png</image>
    </screenshot>
  </screenshots>

  <categories>
    <category>Settings</category>
    <category>System</category>
  </categories>

  <keywords>
    <keyword>settings</keyword>
    <keyword>configuration</keyword>
    <keyword>system</keyword>
    <keyword>specs</keyword>
    <keyword>hardware</keyword>
  </keywords>

  <url type="homepage">https://capivaraos.org</url>
  <url type="bugtracker">https://github.com/capivaraos/cos-config/issues</url>
  <url type="vcs-browser">https://github.com/capivaraos/cos-config</url>

  <developer id="org.capivaraos">
    <name>CapivaraOS Project</name>
  </developer>

  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#c9a27a</color>
    <color type="primary" scheme_preference="dark">#16233d</color>
  </branding>

  <releases>
    <release version="0.7.1" date="2026-10-07">
      <description>
        <p>Fixes mounting disks at startup on systems whose /etc/fstab has no warnings at all.</p>
      </description>
    </release>
    <release version="0.7.0" date="2026-10-02">
      <description>
        <p>New module to mount extra disks automatically at startup, safely: a missing disk never stops the computer from starting.</p>
      </description>
    </release>
    <release version="0.6.0" date="2026-10-02">
      <description>
        <p>New language and formats module: choose the system language and, separately, how dates, numbers and money are shown, and install the language pack.</p>
      </description>
    </release>
    <release version="0.5.0" date="2026-10-02">
      <description>
        <p>New Brazilian keyboard module: pick ABNT2 or US International, make ' + c type ç in every app, and use the same layout on the login screen.</p>
      </description>
    </release>
    <release version="0.4.0" date="2026-10-02">
      <description>
        <p>New module to play any video or music: complete codecs, hardware video acceleration, RPM Fusion and all Flathub apps, in one place.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-02">
      <description>
        <p>New Settings tab with configuration modules grouped by category and a search. The first module caps how much disk the system logs may use.</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-01">
      <description>
        <p>Capivara Fetch is now COS Config Center, with a new name and logo.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-07-24">
      <description>
        <p>First public preview: system info view and shareable specs card.</p>
      </description>
    </release>
  </releases>
</component>
